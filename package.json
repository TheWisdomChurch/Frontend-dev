{
  "name": "wisdomhousehq-webapplication",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run media:optimize",
    "build": "next build --webpack",
    "start": "next start -p 2000",
    "media:optimize": "node scripts/media-pipeline.mjs",
    "media:optimize:dry": "node scripts/media-pipeline.mjs --dry-run",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.js,.jsx --cache --cache-location .cache/eslint/ --no-warn-ignored",
    "lint:fix": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.js,.jsx --cache --cache-location .cache/eslint/ --fix --no-warn-ignored",
    "type-check": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "validate": "npm run architecture:check && npm run type-check && npm run lint && npm run prettier && npm test",
    "prepare": "node -e \"const fs = require('fs'); if (fs.existsSync('.githooks/setup-hooks')) require('child_process').execSync('chmod +x .githooks/setup-hooks && ./.githooks/setup-hooks', { stdio: 'inherit' })\"",
    "postinstall": "npm run hooks:setup || echo 'Note: Run npm run hooks:setup to configure Git hooks'",
    "hooks:setup": "./.githooks/setup-hooks || (echo 'Making setup executable...' && chmod +x .githooks/setup-hooks && ./.githooks/setup-hooks)",
    "hooks:test": "echo 'Creating test commit...' && touch .hook-test && git add .hook-test && git commit -m 'Testing git hooks' && rm .hook-test || echo 'Commit failed (hooks working!)'",
    "hooks:dry-run": "./.githooks/pre-commit",
    "hooks:dry-run:commit": "./.githooks/pre-commit",
    "hooks:dry-run:push": "./.githooks/pre-push",
    "ci:validate": "npm run validate && npm run build",
    "docker:dev": "docker compose --profile dev up --build frontend-dev",
    "docker:prod": "docker compose --profile prod up --build -d frontend-prod",
    "docker:build": "docker build --target production -t wisdom-house .",
    "docker:build:dev": "docker build --target development -t wisdom-house-dev .",
    "docker:run": "docker run --rm -p 2000:2000 wisdom-house",
    "docker:down": "docker compose --profile dev --profile prod down",
    "lint:strict": "eslint src tests --ext .ts,.tsx,.js,.jsx --max-warnings 0 --no-warn-ignored"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.10.1",
    "@types/gsap": "^1.20.2",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.8.0",
    "next": "16.3.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.69.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^9.2.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/google.maps": "^3.65.4",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^15.15.0",
    "lint-staged": "^16.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
