# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

husky/

# testing
/coverage

# next.js
/.next/
/.next-prepush/
/.next-verify/
/.next-audit/
/out/
/public/_optimized/
lintstagedrc.json
eslintrc.json
prettierignore
prettierrc
commitlint.config.js
dockerignore
eslint.config.mjs

# production
/build

# misc
.DS_Store
*.pem
src/archive/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cache/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
/md
# Regenerated by every `next build` / `next dev`; its import paths follow the
# active dist dir (.next / .next-verify / .next-prepush), so committing it just
# creates churn and stale references.
next-env.d.ts
