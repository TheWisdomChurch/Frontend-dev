#!/usr/bin/env bash
set -euo pipefail

# ── Gate ────────────────────────────────────────────────────────────────────
if [[ "${SKIP_GIT_HOOKS:-0}" == "1" ]]; then
  echo "[pre-push] SKIP_GIT_HOOKS=1 — skipping."
  exit 0
fi

if [[ ! -d node_modules ]]; then
  echo "[pre-push] ✖  node_modules missing. Run: npm install"
  exit 1
fi

echo ""
echo "┌─────────────────────────────────────────────────────────────┐"
echo "│  pre-push: full repository validation …                     │"
echo "└─────────────────────────────────────────────────────────────┘"

# Artifact cleanup on exit
cleanup() {
  if [[ "${KEEP_PREPUSH_ARTIFACTS:-0}" != "1" ]]; then
    rm -rf .next-prepush
  fi
}
trap cleanup EXIT

if [[ "${KEEP_PREPUSH_ARTIFACTS:-0}" != "1" ]]; then
  rm -rf .next-prepush
fi

# ── 1. TypeScript – full project ─────────────────────────────────────────────
echo "[pre-push] 1/3  TypeScript full type check …"
mkdir -p .cache/tsc
node ./node_modules/typescript/bin/tsc \
  --noEmit \
  --skipLibCheck \
  --incremental \
  --tsBuildInfoFile .cache/tsc/pre-push.tsbuildinfo
echo "[pre-push] ✔  TypeScript passed."

# ── 2. ESLint – full project (errors only; warnings are non-blocking) ────────
echo "[pre-push] 2/3  ESLint full scan (errors block push) …"
node ./node_modules/eslint/bin/eslint.js src \
  --ext .ts,.tsx,.js,.jsx \
  --cache \
  --cache-location .cache/eslint/ \
  --no-warn-ignored
echo "[pre-push] ✔  ESLint passed (0 errors)."

# ── 3. Next.js production build ──────────────────────────────────────────────
if [[ "${SKIP_PREPUSH_BUILD:-0}" == "1" ]]; then
  echo "[pre-push] SKIP_PREPUSH_BUILD=1 — skipping build."
  echo ""
  echo "✅  TypeScript + ESLint passed. Push approved."
  exit 0
fi

echo "[pre-push] 3/3  Next.js production build …"
NEXT_DIST_DIR=.next-prepush node ./node_modules/next/dist/bin/next build --no-lint
echo "[pre-push] ✔  Build passed."

echo ""
echo "✅  All pre-push checks passed. Pushing …"
