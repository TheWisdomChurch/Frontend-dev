# syntax=docker/dockerfile:1
FROM node:22-alpine

WORKDIR /app

# Install native dependencies for media pipeline (sharp, ffmpeg) and SSL certificates
RUN apk add --no-cache ca-certificates libc6-compat ffmpeg \
 && update-ca-certificates

ARG NPM_REGISTRY=https://registry.npmjs.org/
RUN npm config set registry ${NPM_REGISTRY} \
 && npm config set fetch-retries 5 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 120000

# Copy package manifests first for optimal Docker layer caching
COPY package*.json ./

# Disable Git hooks inside the container build
RUN npm pkg delete scripts.prepare || true \
 && npm pkg delete scripts.postinstall || true

# Install all dependencies (including devDependencies required for Next dev server)
RUN npm ci --no-audit --no-fund

# Copy the rest of the application files
COPY . .

# Development environment variables
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV DOCKER_ENV=true
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
ENV NEXT_WEBPACK_USEPOLLING=1
ENV WATCHPACK_POLLING_INTERVAL=800
ENV PORT=2000

EXPOSE 2000

# Start development server with live reload enabled
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "2000"]

